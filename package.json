{
	"name": "wp-main-theme-development",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "node scripts/preview.mjs",
		"test:preview": "node scripts/smoke-preview.mjs",
		"test:products": "node scripts/test-product-details.mjs",
		"test:navigation": "node scripts/test-navigation.mjs",
		"check": "node --check scripts/preview.mjs && node --check themes/wp-main-theme/assets/js/navigation.js",
		"test:layouts": "node scripts/test-layouts.mjs",
		"test:cards": "node scripts/test-cards.mjs",
		"test:search": "node scripts/test-search.mjs",
		"test:catalog": "node scripts/test-catalog.mjs",
		"test:features": "node scripts/test-features.mjs",
		"test:shopping": "node scripts/test-shopping.mjs",
		"test:php": "node scripts/test-php.mjs",
		"check:assets": "node scripts/measure-assets.mjs",
		"test:search-ui": "node scripts/test-search-ui.mjs",
		"test:recovery": "node scripts/test-recovery.mjs",
		"test:order": "node scripts/test-order.mjs",
		"test:catalog-polish": "node scripts/test-catalog-polish.mjs",
		"test:cart-feedback": "node scripts/test-cart-feedback.mjs",
		"test:seo": "node scripts/test-seo.mjs",
		"test:release": "node scripts/test-release.mjs",
		"test:integration": "node scripts/run-preview-suite.mjs --isolated",
		"check:translations": "python scripts/build-translations.py --check",
		"build:translations": "python scripts/build-translations.py"
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@wp-playground/cli": "3.1.40"
	}
}
